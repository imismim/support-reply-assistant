# Postgres connection used by the app (docker-compose service name is "db")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support_reply

# Redis used for the job queue and the LLM rate limiter
REDIS_URL=redis://redis:6379/0

# LLM provider for draft generation: "gemini" (default, has a free tier)
# or "anthropic". Leave the selected provider's key empty to run in
# "no API key" fallback mode: the service still makes a real request to the
# provider (which will fail auth) and then returns a static draft after a
# realistic random delay, as required by the task spec.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Service-wide LLM rate limit
LLM_RATE_LIMIT_PER_MINUTE=60
# Draft generation retries on LLM errors (429/503) before the ticket is marked failed
LLM_MAX_RETRIES=5

# Outbound reply delivery to the (mocked) helpdesk
HELPDESK_TIMEOUT_SECONDS=10
HELPDESK_MAX_RETRIES=5
