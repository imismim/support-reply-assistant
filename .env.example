# Postgres connection used by the app (docker-compose service name is "db")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support_reply

# Redis used for the job queue and the LLM rate limiter
REDIS_URL=redis://redis:6379/0

# Leave empty to run in "no API key" fallback mode: the service still makes a
# real request to Anthropic (which will fail auth) and then returns a static
# draft after a realistic random delay, as required by the task spec.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Service-wide LLM rate limit
LLM_RATE_LIMIT_PER_MINUTE=60

# Outbound reply delivery to the (mocked) helpdesk
HELPDESK_TIMEOUT_SECONDS=10
HELPDESK_MAX_RETRIES=5
